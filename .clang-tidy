# clang-tidy configuration for ft_ping.
# Wide families enabled; a few checks excluded because they don't fit low-level C
# (ICMP type constants are not "magic numbers", short names like fd/n/i are clear
# in context, easily-swappable-parameters is noisy on C signatures, and the
# Annex K *_s functions that insecureAPI asks for are absent from glibc).
#
# misc-include-cleaner is kept ON for project headers (it enforces direct
# includes, e.g. pulling in ft_ping.h/net.h) but told to ignore the low-level
# system header families whose macros/enums live in non-includable inner headers
# (asm-generic/socket.h for SOL_SOCKET, the netinet enums for IPPROTO_*, and
# sys/socket.h when only its SOCK_* constants are used, as icmp.c does).

Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -bugprone-easily-swappable-parameters,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling

WarningsAsErrors:   '*'
HeaderFilterRegex:  '^(src|include)/.*\.h$'
FormatStyle:        file
CheckOptions:
  misc-include-cleaner.IgnoreHeaders: 'asm/.*;asm-generic/.*;bits/.*;linux/.*;netinet/.*;arpa/.*;sys/socket\.h'
